{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent",
    "status",
    "steps",
    "cancelled",
    "question",
    "changes",
    "reply"
  ],
  "properties": {
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "status": {
      "type": "string",
      "enum": [
        "accept",
        "clarify"
      ]
    },
    "question": {
      "type": "string",
      "maxLength": 200
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action",
          "target",
          "observation_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,40}$"
          },
          "action": {
            "type": "string",
            "enum": [
              "search",
              "reobserve",
              "return_home"
            ]
          },
          "target": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "blue",
              "green",
              null
            ]
          },
          "observation_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "cancelled": {
      "type": "array",
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "instruction"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "instruction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "changes": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "permission",
          "instruction"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "permission": {
            "type": "string",
            "enum": [
              "allow",
              "avoid"
            ]
          },
          "instruction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "reply": {
      "type": "string",
      "maxLength": 300
    }
  }
}
