{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "forward",
              "backward",
              "turn_left",
              "turn_right",
              "wait"
            ]
          },
          "duration": {
            "type": "number",
            "minimum": 0.2,
            "maximum": 2.0
          }
        },
        "required": [
          "type",
          "duration"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "intent",
    "actions"
  ],
  "additionalProperties": false
}
